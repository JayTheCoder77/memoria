# Copy to .env in this directory and fill in values.
# Loaded automatically by pydantic-settings (MEMORIA_ prefix).

# Postgres — local docker, or a Neon URI in production
MEMORIA_DATABASE_URL=postgresql+psycopg://memoria:memoria@localhost:5432/memoria

# hash (tests) | minilm (in-process, needs uv sync --extra minilm) | hf (Hugging Face Inference)
# Do not mix embedders in the same DB — wipe memories after switching.
MEMORIA_EMBEDDER=hash
MEMORIA_HF_TOKEN=
MEMORIA_HF_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Run the extraction worker inside uvicorn (Render free tier has no background workers)
MEMORIA_RUN_WORKER=false

# Comma-separated browser origins (Vercel site). MCP/curl do not need CORS.
MEMORIA_CORS_ORIGINS=

# Session JWT for dashboard users. Use a long random string in production.
# Also used to encrypt per-org OpenRouter keys (BYOK).
MEMORIA_JWT_SECRET=dev-secret-change-me-please-use-32b+
MEMORIA_JWT_TTL_MINUTES=1440
MEMORIA_SESSION_COOKIE_NAME=memoria_session

# Same Google OAuth Web client ID as AUTH_GOOGLE_ID in apps/web
MEMORIA_GOOGLE_CLIENT_ID=

# API-key rate limit (requests per minute per key)
MEMORIA_RATE_LIMIT_PER_MINUTE=120

# Extraction defaults. Users paste their own OpenRouter key in dashboard Settings.
# Without a key the worker uses the heuristic extractor.
MEMORIA_LLM_MODEL=openai/gpt-4o-mini
MEMORIA_LLM_BASE_URL=https://openrouter.ai/api/v1
MEMORIA_OPENROUTER_HTTP_REFERER=http://localhost:3000
MEMORIA_OPENROUTER_APP_TITLE=Memoria
MEMORIA_EXTRACT_BATCH_SIZE=10
MEMORIA_DEDUP_THRESHOLD=0.92
MEMORIA_CONSOLIDATE_THRESHOLD=0.85

# Hybrid stores (v2). Keep off until KV/Graph implementations exist.
MEMORIA_ENABLE_KV=false
MEMORIA_ENABLE_GRAPH=false
MEMORIA_FUSION_WEIGHT_RELEVANCE=0.6
MEMORIA_FUSION_WEIGHT_IMPORTANCE=0.2
MEMORIA_FUSION_WEIGHT_RECENCY=0.2
MEMORIA_RECENCY_HALFLIFE_DAYS=14
