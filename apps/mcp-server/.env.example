# Copy to .env in this directory and fill in values.

# Memory API base URL (no trailing slash). Hosted:
# MEMORY_API_URL=https://memoria-api-jw5g.onrender.com
MEMORY_API_URL=http://127.0.0.1:8000

# Machine auth for this MCP process (dashboard → API Keys). Never put this in prompts.
MEMORY_API_KEY=mem_...

# Optional. Omit this so each harness process gets its own session_id.
# Writes rotate to a new id after emit(session_end). Recall is org-wide unless set.
# MEMORY_SESSION_ID=
