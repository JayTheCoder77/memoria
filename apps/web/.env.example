# Copy to .env.local in this directory and fill in values.
# Next.js loads .env / .env.local automatically.

# Google OAuth 2.0 Web client (authorized redirect:
# http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Memory API used for Google ID-token exchange and key management
MEMORY_API_URL=http://127.0.0.1:8000

# Public API URL baked into the docs MCP snippet (Vercel build)
NEXT_PUBLIC_MEMORY_API_URL=http://127.0.0.1:8000
